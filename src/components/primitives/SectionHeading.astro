---
/** A section title with its rule. `srOnly` marks a Continuation (ADR-0005). */
interface Props {
  text: string;
  srOnly?: boolean;
}

const { text, srOnly } = Astro.props;
---

<h2 class:list={['section-heading', { 'is-sr-only': srOnly }]}>{text}</h2>

<style>
  @layer components {
    .section-heading {
      font-size: var(--font-size-heading);
      /* Set solid, as the reference does — a 22.66px face on a 23px em-box. */
      line-height: 1.015;
      padding-block-end: calc(var(--space-xs) / 4);
      border-block-end: 1px solid currentcolor;
    }

    /* `.is-sr-only` is in the `base` layer, so the rule above outranks its own
       reset — the component that draws it has to take it back. */
    .section-heading.is-sr-only {
      padding-block-end: 0;
      border-block-end: 0;
    }
  }
</style>
