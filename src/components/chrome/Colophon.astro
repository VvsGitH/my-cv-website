---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CvContent } from '../../content/types';
import { otherLocale } from '../../i18n/locale';
import { ui } from '../../i18n/ui';

/**
 * The Colophon (CONTEXT.md) — ADR-0013. The name and both channels are derived
 * from the header Block rather than restated, at the cost recorded there.
 */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const other = otherLocale(content.locale);
const strings = ui[content.locale].colophon;

const header = content.blocks.find((block) => block.kind === 'header');
if (!header) {
  throw new Error(`[colophon] the ${content.locale} content has no header Block to sign off.`);
}

// Località has no `url` because it is not an action, and drops out here.
const channels = header.contacts.filter((contact) => contact.url);

// From the build, not the page load — a copyright notice dates publication (ADR-0013).
const year = new Date().getFullYear();
---

<footer role="contentinfo" class="colophon" aria-label={strings.name}>
  <p class="imprint">© {year} {header.name}</p>

  <ul class="channels">
    <li>
      <a href={getRelativeLocaleUrl(other)} lang={other} hreflang={other}>
        {ui[other].colophon.localeName}
      </a>
    </li>
    {
      channels.map((contact) => (
        <li>
          <a href={contact.url}>{contact.label}</a>
        </li>
      ))
    }
  </ul>

  <p>{strings.dataNotice}</p>


  <p>{strings.accessibility}</p>
</footer>

<style>
  @layer components {
    .colophon {
      max-width: 200ch;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0 var(--space-m);

      margin-inline: auto;
      padding: var(--space-l) var(--space-l) var(--space-xl) var(--space-l);
      font-size: var(--font-size-body);
      text-align: center;
      line-height: 1.6;
      /* It stands on the page background, not on paper — and now that the two
         move together, the ink it needs is just the heading (ADR-0015). The
         ladder this used to carry lives in tokens.css. */
      color: var(--color-heading);
    }

    .colophon > * {
      width: max-content;
    }

    /* With one size and one ink to spend, tracking is the whole hierarchy (ADR-0013). */
    .imprint {
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .channels {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-s);
    }

    .channels a {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    /* The reading column's own measure: the Colophon runs in the column rather
       than under it. The Mode, because that is what sets the column (ADR-0017). */
    :global(html[data-mode='reading']){ 
      .colophon {
        max-width: var(--reading-column-max);
      }
    }

    /* Reserves the rectangle the Toolbar floats in, rather than indenting out of
       the column to dodge it (ADR-0013). A width, not the Mode: what has to be
       cleared is the horizontal row against the bottom edge, and that shape is
       the narrow tier's at either Mode. The rail the wide tiers get instead
       stands beside the paper, clear of normal flow. */
    @media screen and (width < 53.5rem) {
      .colophon {
        padding-block-end: calc(
          var(--toolbar-block-size) + var(--toolbar-inset) + var(--space-xl)
        );
      }
    }
  }

  @layer print {
    /* Chrome is never captured (CONTEXT.md). */
    @media print {
      .colophon {
        display: none;
      }
    }
  }
</style>
