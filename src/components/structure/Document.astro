---
import type { CvContent } from '../../content/types';
import Sheet from './Sheet.astro';

/** The whole CV: its two Sheets, laid out as paper. */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
---

<!-- The container the paper measures itself against. Block-level, so `cqw` inside
  resolves to the width actually available — which `100vw` does not, because it
  counts the scrollbar and would put the Sheet back over the edge it just fitted. -->
<div class="paper">
  <div class="sheets">
    <Sheet content={content} sheet={1} />
    <Sheet content={content} sheet={2} />
  </div>
</div>

<style>
  @layer components {
    /* The width the fit measures itself against. Load-bearing, and measured: a
       `cqw` with no query container above it falls back to the small viewport,
       which counts the classic scrollbar that the content box does not. In a real
       browser window at 390px — 15px of scrollbar — `100cqw` reports 390 while
       `.paper` is 375, so the Sheet comes out 342px wide inside a 327px box and
       eats half the gutter either side. Headless Chromium cannot see it: its
       scrollbars are overlay and take no space, so every assertion in the suite
       passes with this rule deleted. */
    .paper {
      container-type: inline-size;
    }

    .sheets {
      /* Screen gutters, not paper geometry — and the whole of the arithmetic
         below: they set both the width the paper is fitted to and, with the gap,
         the width at which the pair stops sharing a line. Named rather than
         repeated, and zeroed for print in the layer below. */
      --sheets-gap: 1.5rem;
      --sheets-pad: 0.5rem;

      gap: var(--sheets-gap);
      padding: var(--sheets-gap) var(--sheets-pad);

      /* A wrapping line, not a grid with a breakpoint: the pair goes side by side
         exactly when there is room for it — 1704px of paper inside the two
         gutters, so 1752px of viewport — and the wide tier stops being a number
         somebody has to keep in step with the paper's own width. It was the one
         boundary written down, and it is now emergent.

         Declared for both media and taken back in `print` below rather than
         fenced behind `@media screen`: the paper's printed geometry is then
         stated in one place, instead of being whatever survived a guard. The
         cost is that the print layer has to name what it cancels. */
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    /* Paper Mode below the paper's own width: the Sheet is scaled to fit rather
      than allowed over the edge, which is what ADR-0006 §2 removed and ADR-0017
      puts back — for the one case it removed it for, and by the mechanism that
      makes it safe. `zoom` scales at layout time, so nothing is left behind;
      `transform` would cost the PDF its fonts (Sheet.astro).

      `min(1, …)` is the whole guarantee ADR-0006 wanted: the paper is fitted
      down, never up, so every width at or above 888px renders as it did. */
    .sheets :global(.sheet) {
      zoom: min(1, calc(100cqw / var(--sheet-width)));
    }

    /* Reading Mode: one column of Blocks at a comfortable measure. The Sheets'
       own boxes are dismantled in Sheet.astro, so the items in this grid are the
       Blocks themselves — from both Sheets and both columns, sequenced by the
       `order` that component sets.

       The surface is the page's colour, not the paper's: with the Sheets taken
       apart there is no paper left to be a second surface against, and a column
       painted `--color-main-bg` would draw an edge around a box that is no longer
       a Sheet. It still takes the theme from the same ladder (ADR-0015).

       `min-width` is dropped: the Mode is now reachable at any width, so it has
       to survive a 320px phone rather than assume a measure's worth of room. */
    :global(html[data-mode='reading']) {
      .sheets {
        flex-direction: column;
        gap: 0;
        max-width: var(--reading-column-max);
        margin-inline: auto;
        /* Outside the spacing scale on purpose: this is the gap between the paper
           and the Chrome below it, not one between units of CV content (ADR-0011). */
        margin-block-end: var(--space-xl);
        /* No block padding: every Block carries the gap above it instead, because
           `order` makes `:first-child` meaningless (Sheet.astro). */
        padding: 0 var(--space-l) var(--space-xl);
        background-color: var(--color-page-bg);
      }

      .sheets :global(.sheet) {
        zoom: 1;
      }
    }
  }

  @layer print {
    /* The screen gutter must not reach paper: with it, the first Sheet is
       pushed off its A4 page and every Sheet spills onto a second one. The
       Sheets themselves are untouched, so print output equals the screen
       rendering (ADR-0001). */
    @media print {
      .paper {
        /* Not cosmetic: `container-type` brings layout containment, and a
           layout-contained box is monolithic for fragmentation — over both Sheets
           it can swallow the `break-before: page` below, which is the whole of what
           makes the CV two pages (coding-standards). The fit it serves is a screen
           concern; here the print layer's own `zoom` sizes the paper. */
        container-type: normal;
      }

      .sheets {
        display: block;
        gap: 0;
        padding: 0;
        justify-content: normal;
      }

      .sheets > * + * {
        break-before: page;
      }
    }
  }
</style>
