---
import { Image } from 'astro:assets';
import profilePhoto from '../../assets/images/profile.png';
import type { PhotoBlock } from '../../content/types';

/**
 * The cut-out portrait over its disc. The disc colour stays behind the `<Image>`
 * in case a future photo is not fully opaque to its edges; the intrinsic size is
 * 2x the CSS disc, for print and retina.
 */
interface Props {
  block: PhotoBlock;
}

const { block } = Astro.props;
---

<div class="photo">
  <Image src={profilePhoto} alt={block.alt} width={353} height={353} />
</div>

<style>
  @layer components {
    .photo {
      /* Centred in the Aside panel. --photo-size is also the floor Main's header
         Block answers to, which is what aligns the two columns; see Sheet.astro. */
      width: var(--photo-size);
      aspect-ratio: 1;
      margin-inline: auto;
      border-radius: 50%;
      background-color: var(--color-aside-accent);
      overflow: hidden;
    }

    .photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
