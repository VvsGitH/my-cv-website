---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CvContent } from '../../content/types';
import { otherLocale } from '../../i18n/locale';
import { ui } from '../../i18n/ui';
import Colophon from './Colophon.astro';
import Toolbar from './Toolbar';

/**
 * The Chrome (CONTEXT.md): one island and the Colophon. ADR-0008, ADR-0013.
 *
 * It was two islands until ADR-0017. The Drawer existed because Reading Mode was
 * a viewport width, which meant the Aside's Blocks had to be rendered a second
 * time into a panel — CSS cannot reparent. Now the Mode is chosen and the Aside
 * reads in the column itself, so the panel, the second copy and the signal that
 * crossed between them are all gone.
 */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const strings = ui[content.locale];

// Written down twice, deliberately (ADR-0009). Change one end, change the other.
const pdfHref = `${import.meta.env.BASE_URL}Vito_Paparella_Santorsola_CV_${content.locale.toUpperCase()}.pdf`;
---

<Toolbar
  client:idle
  toolbar={strings.toolbar}
  links={{
    languageHref: getRelativeLocaleUrl(otherLocale(content.locale)),
    languageLocale: otherLocale(content.locale),
    pdfHref,
  }}
/>

<Colophon content={content} />
