---
import { Image } from 'astro:assets';
import type { PhotoBlock } from '../../content/types';
import profilePhoto from '../../assets/images/profile.png';

/**
 * The cut-out portrait over its disc. The disc colour stays behind the `<Image>`
 * in case a future photo is not fully opaque to its edges; the intrinsic size is
 * 2x the CSS disc, for print and retina.
 */
interface Props {
  block: PhotoBlock;
}

const { block } = Astro.props;
---

<div class="photo">
  <Image src={profilePhoto} alt={block.alt} width={353} height={353} />
</div>

<style>
  @layer components {
    .photo {
      /* Centred in the Aside panel. Its height is one of the four inputs to
         --main-first-heading-gap; see tokens.css. */
      width: var(--photo-size);
      aspect-ratio: 1;
      margin-inline: auto;
      border-radius: 50%;
      background-color: var(--color-photo-circle);
      overflow: hidden;
    }

    .photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
