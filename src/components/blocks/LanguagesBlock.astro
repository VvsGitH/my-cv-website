---
import type { LanguagesBlock } from '../../content/types';
import SectionHeading from '../primitives/SectionHeading.astro';

interface Props {
  block: LanguagesBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} />
<dl class="languages">
  {
    block.entries.map((entry) => (
      <div class="language">
        <dt>{entry.name}</dt>
        <dd>{entry.level}</dd>
        <div
          class="bar"
          style={`--fill: ${(entry.proficiency * 100).toFixed(1)}%`}
        ></div>
      </div>
    ))
  }
</dl>

<style>
  @layer components {
    .languages {
      margin-block-start: var(--space-m);
      color: var(--color-heading);
    }

    .language {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      line-height: 1.15;
    }

    .language + .language {
      margin-block-start: var(--space-m);
    }

    dd {
      margin-inline-start: 0;
      font-style: italic;
      color: var(--color-muted);
    }

    .bar {
      grid-column: 1 / -1;
      /* The reference draws a ~5px rule: the filled run in --color-muted
         over a pale-blue track. */
      height: var(--skill-bar-height);
      margin-block-start: var(--space-xs);
      background-image: linear-gradient(
        to right,
        var(--color-muted) var(--fill),
        var(--color-bar-track) var(--fill)
      );
    }
  }
</style>
