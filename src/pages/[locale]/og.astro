---
import { Font } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import Sheet from '../../components/structure/Sheet.astro';
import { cv } from '../../content';
import { localePaths } from '../../i18n/locale';
import { ogCard } from '../../lib/og-card';
import '../../styles/global.css';

/** The link-preview image is a route, not a composed screenshot (ADR-0009). */
export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;
const { locale } = Astro.props;

const content = cv[locale];

const header = content.blocks.find((block) => block.kind === 'header');
if (!header) {
  throw new Error(`[og] the ${locale} content has no header Block to name the card with.`);
}
---

<!doctype html>
<!-- Pinned light, and never the theme: the card paints its own dark ground below,
  and the Sheet inside it has to stay white paper (ADR-0015). Explicit rather
  than absent, so the headless browser that screenshots this cannot bring a
  `prefers-color-scheme` of its own. -->
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <title>{header.name} — link preview ({locale})</title>
    <meta name="robots" content="noindex" />

    <!-- No `preload`, the capture waits on `document.fonts` -->
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-atkinson" />
    <Font cssVariable="--font-icomoon" />
    <Font cssVariable="--font-primera-signature" />

    <style is:inline>
      /* Cascade layer order (lowest to highest precedence): 
        reset < base < components < print. 
        This bare statement must come first */
      @layer reset, base, components, print;
    </style>
  </head>
  <body>
    <div
      class="card"
      data-og-card
      style={`--card-width: ${ogCard.width}px; --card-height: ${ogCard.height}px`}
    >
      <div class="intro">
        <p class="name">{header.name}</p>
        <p class="role">{header.title}</p>
      </div>
      <div class="paper">
        <Sheet content={content} sheet={1} />
      </div>
    </div>
  </body>
</html>

<style>
  @layer components {
    .card {
      /* --card-width / --card-height arrive unitless from lib/og-card.ts: the
         Sheet's scale below is a ratio of two of these, and CSS cannot divide
         one length by another. */
      --card-pad-block: 48px;
      /* Named off the dark ramp, not off the light surface it happens to match:
         the card is a dark ground wherever it is embedded. */
      --card-ink: var(--color-heading-dark);

      display: flex;
      align-items: center;
      gap: 4rem;
      width: var(--card-width);
      height: var(--card-height);
      padding-block: var(--card-pad-block);
      padding-inline: 4rem;
      background-color: var(--color-main-bg-dark);
    }

    .intro {
      flex: 1;
    }

    /* The name as the Sheet sets it, at the size a feed thumbnail needs. */
    .name {
      font-family: var(--font-name);
      font-weight: var(--font-weight-name);
      font-size: 3.25rem;
      line-height: 1.05;
      letter-spacing: 0.038em;
      text-transform: uppercase;
      color: var(--card-ink);
    }

    .role {
      margin-block-start: var(--space-m);
      font-family: var(--font-subtitle);
      font-weight: var(--font-weight-subtitle);
      font-size: 1.5rem;
      letter-spacing: 0.055em;
      /* This should be equal to the accent color of the light aside used in the right page */
      color: var(--color-aside-accent-light);
    }

    .paper {
      box-shadow: 0 1.25rem 3rem oklch(0% 0 0 / 0.45);
    }

    /* The Sheet's own seam, so the A4 box stays real and only its rendering
       shrinks. */
    .paper :global(.sheet) {
      --calc-card-height: calc(var(--card-height) - 2 * var(--card-pad-block));
      --calc-sheet-height: calc(var(--sheet-width) / calc(var(--sheet-ar)));
      zoom: calc(var(--calc-card-height) / var(--calc-sheet-height));
    }
  }
</style>
