---
import type { Block } from '../../content/types';
import PhotoBlock from '../blocks/PhotoBlock.astro';
import HeaderBlock from '../blocks/HeaderBlock.astro';
import AboutBlock from '../blocks/AboutBlock.astro';
import SkillsBlock from '../blocks/SkillsBlock.astro';
import MainSectionBlock from '../blocks/MainSectionBlock.astro';
import BulletsBlock from '../blocks/BulletsBlock.astro';
import LanguagesBlock from '../blocks/LanguagesBlock.astro';
import CertificationsBlock from '../blocks/CertificationsBlock.astro';
import PrivacyBlock from '../blocks/PrivacyBlock.astro';

/** Renders one Block, dispatching on its `kind`. */
interface Props {
  block: Block;
}

const { block } = Astro.props;

// Reading Mode reflows with `order` rather than a second render, so the rank
// travels to CSS as a custom property (ADR-0017). `data-continues` is what lets
// the same stylesheet close the gap above a Continuation.
const continues = 'continues' in block && block.continues ? '' : undefined;
---

<article
  class:list={['block', `block--${block.kind}`]}
  style={`--read-order: ${block.readOrder}`}
  data-continues={continues}
>
  {block.kind === 'photo' && <PhotoBlock block={block} />}
  {block.kind === 'header' && <HeaderBlock block={block} />}
  {block.kind === 'about' && <AboutBlock block={block} />}
  {block.kind === 'skills' && <SkillsBlock block={block} />}
  {block.kind === 'mainSection' && <MainSectionBlock block={block} />}
  {block.kind === 'bullets' && <BulletsBlock block={block} />}
  {block.kind === 'languages' && <LanguagesBlock block={block} />}
  {block.kind === 'certifications' && <CertificationsBlock block={block} />}
  {block.kind === 'privacy' && <PrivacyBlock block={block} />}
</article>

<style>
  @layer components {
    .block {
      /* Never split a Block across Sheets — Explicit Paging owns that. */
      break-inside: avoid;
    }
  }
</style>
