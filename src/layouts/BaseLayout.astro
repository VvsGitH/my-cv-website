---
import '../styles/global.css';

interface Props {
  lang: string;
  title?: string;
}

const { lang, title = 'CV — Vito Paparella Santorsola' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <!-- Chrome sits outside <main>: it is not the paper (CONTEXT.md). The
      Drawer lands here from ticket 06, the Toolbar will from ticket 07. -->
    <slot name="chrome" />
  </body>
</html>
