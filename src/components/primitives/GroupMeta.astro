---
/**
 * The line(s) under a Group's title — employer / institution on the left,
 * the period right-aligned, both in the display face. Only a Group
 * that opens carries this; a Continuation never repeats it.
 */
interface Props {
  lines: string[];
  period: string;
}

const { lines, period } = Astro.props;
---

<div class="group-meta">
  <div class="lines">{lines.map((line) => <p>{line}</p>)}</div>
  <p class="period">{period}</p>
</div>

<style>
  @layer components {
    .group-meta {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: var(--space-s);
      margin-block-start: var(--space-s);
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      font-size: var(--font-size-meta);
      color: var(--color-heading);
      line-height: 1.15;
    }

    .period {
      flex: none;
    }

    :global(html[data-mode='reading']) {
      .group-meta {
        flex-direction: column;
      }
    }
  }
</style>
