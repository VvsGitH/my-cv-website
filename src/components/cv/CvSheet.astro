---
import type { Column, CvContent, SheetNumber } from '../../content/types';
import Sheet from '../Sheet.astro';
import CvBlock from './CvBlock.astro';

/**
 * One Sheet of the CV: the cream Aside panel and the white Main column,
 * each filled with the Blocks that name it (Explicit Paging, ADR-0002).
 * Blocks render in content order.
 */
interface Props {
  content: CvContent;
  sheet: SheetNumber;
}

const { content, sheet } = Astro.props;
const blocksIn = (column: Column) =>
  content.blocks.filter((block) => block.sheet === sheet && block.column === column);
---

<Sheet class="cv-sheet">
  <div class="columns">
    <aside class="aside">
      {blocksIn('aside').map((block) => <CvBlock block={block} />)}
    </aside>
    <div class="main">{blocksIn('main').map((block) => <CvBlock block={block} />)}</div>
  </div>
</Sheet>

<style>
  @layer components {
    .columns {
      display: grid;
      grid-template-areas: 'aside main';
      grid-template-columns: var(--aside-width) var(--main-width);
      column-gap: var(--column-gap);
      height: 100%;
      padding-inline: var(--aside-inset-inline) var(--sheet-pad-inline-end);
    }

    .aside {
      grid-area: aside;
      display: flex;
      flex-direction: column;
      /* The panel stops short of the page bottom, and its heading rules run
         past the text column to the panel's own edge. */
      height: var(--aside-height);
      break-inside: avoid;
      padding-block-start: 2.3625rem;
      padding-inline: var(--aside-pad-inline-start) var(--aside-pad-inline-end);
      background-color: var(--color-aside-bg);
    }

    .main {
      grid-area: main;
      padding-block-start: var(--main-inset-block-start);
    }

    /* Gap above a new section. The reference hand-places these, so one
       value can't hit every one exactly — see the ticket notes. */
    .aside :global(.block > .section-heading) {
      margin-block-start: 2.5rem;
    }

    .main :global(.block > .section-heading) {
      margin-block-start: 5.35rem;
    }

    /* Needs the column prefix: the two rules above are scoped (Astro adds
       an attribute to `.aside`/`.main`), so an unprefixed override would
       lose on specificity and the first section would gain a gap. */
    .aside :global(.block:first-child > .section-heading),
    .main :global(.block:first-child > .section-heading) {
      margin-block-start: 0;
    }

    /* Experience sits close under the header, unlike a section following
       another section's entries. */
    .main :global(.block--header + .block > .section-heading) {
      margin-block-start: 1.545rem;
    }

    .main :global(.block + .block) {
      margin-block-start: 0.9rem;
    }

    /* Privacy is anchored to the foot of the Aside. */
    .aside :global(.block--privacy) {
      margin-block-start: auto;
    }

    .aside :global(.block > .section-heading) {
      /* Rules reach the panel edge; the text column stops short of it. */
      margin-inline-end: calc(-1 * var(--aside-pad-inline-end));
    }
  }
</style>
