---
/**
 * The title line of an Experience, Project or Education entry — the job
 * role, the project name, the qualification. All three are set identically
 * in the reference.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<h3 class="entry-title">{text}</h3>

<style>
  @layer components {
    .entry-title {
      font-family: var(--font-heading);
      font-weight: var(--font-weight-heading);
      font-size: var(--font-size-subheading);
      line-height: 1.5;
      color: var(--color-heading);
    }

    /* `.section-heading` comes from the SectionHeading component, so it
       carries a different scope hash and has to be matched globally. */
    :global(.section-heading) + .entry-title {
      margin-block-start: 1.19rem;
    }
  }
</style>
