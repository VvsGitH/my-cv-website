---
import '../styles/fonts.css';

interface Props {
  lang: string;
  title?: string;
}

const { lang, title = 'CV — Vito Paparella Santorsola' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  /* :global() is required — content passed via <slot /> isn't scoped to
     this component's own styles. */
  :global(main h1) {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-heading);
  }

  :global(main p) {
    font-family: var(--font-body);
    font-weight: var(--font-weight-body);
  }
</style>
