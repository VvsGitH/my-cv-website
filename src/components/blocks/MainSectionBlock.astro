---
import type { MainSectionBlock } from '../../content/types';
import Bullets from '../primitives/Bullets.astro';
import GroupMeta from '../primitives/GroupMeta.astro';
import GroupTitle from '../primitives/GroupTitle.astro';
import Rich from '../primitives/Rich.astro';
import SectionHeading from '../primitives/SectionHeading.astro';

/**
 * One Main section — Experience, Selected Projects, Education — as one
 * `<article>`, one `<h2>` and n `<section>` Groups (ADR-0005). The three read
 * identically in the reference, so they render through one component rather
 * than three near-copies.
 */
interface Props {
  block: MainSectionBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} srOnly={block.continues} />
{block.groups.map((group) => (
    <section class="group">
      <GroupTitle text={group.title} srOnly={group.continues} />
      {/* A Continuation resumes mid-Group, so it never repeats the
          organisation or the period — the union makes them unavailable. */}
      {!group.continues && <GroupMeta lines={group.meta} period={group.period} />}
      {group.summary && (
        <div class="summary">
          {group.summary.map((paragraph) => (
            <p>
              <Rich text={paragraph} />
            </p>
          ))}
        </div>
      )}
      {group.bullets && <Bullets items={group.bullets} />}
    </section>
  ))}

<style>
  @layer components {
    .summary {
      margin-block-start: var(--space-s);
      line-height: var(--prose-leading);
      color: var(--color-text);
    }

    .group + .group {
      margin-block-start: var(--space-m);
    }

    /* Same value, but it cannot merge into a single `.group` rule the way
       `SkillsBlock` does: a Continuation's heading is `.is-sr-only` and so
       out of flow, and on paper the Group resuming under it must sit flush at
       the top of the column it opens.
       `:global` because `.section-heading` comes from its own component and
       carries a different scope hash. */
    :global(.section-heading:not(.is-sr-only)) + .group {
      margin-block-start: var(--space-m);
    }

    /* Reading Mode has no column to open, so a Continuation resumes mid-run and
       takes the ordinary gap between Groups — which is the whole of what makes
       the two halves read as one section down here (ADR-0017). The Mode, not a
       width: it is the reflow that removes the column, never the viewport. */
    :global(html[data-mode='reading']) .group:first-of-type {
      margin-block-start: var(--space-m);
    }
  }
</style>
