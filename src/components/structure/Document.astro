---
import type { CvContent } from '../../content/types';
import Sheet from './Sheet.astro';

/** The whole CV: its two Sheets, laid out as paper. */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
---

<div class="sheets">
  <Sheet content={content} sheet={1} />
  <Sheet content={content} sheet={2} />
</div>

<style>
  @layer components {
    .sheets {
      /* Screen gutters, not paper geometry — and also the arithmetic behind the
         two-up boundary below, which is why they are named rather than repeated.
         Zeroed for print in the layer below. */
      --sheets-gap: 1.5rem;
      --sheets-pad: 1.5rem;

      gap: var(--sheets-gap);
      padding: var(--sheets-pad);
    }

    /* Arranging the Sheets is a screen concern, and every alignment declaration
       stays inside `screen` for a measured reason (coding-standards).

       Grid, not a wrapping flex line: a track count cannot move under a
       sub-pixel rounding the way a flex line can. */
    @media screen {
      .sheets {
        display: grid;
        grid-template-columns: max-content;
        justify-content: center;
      }
    }

    /* Wide: two Sheets side by side. 107.5rem clears the pair's 1704px — the
       boundary is reasoned about in tokens.css beside its Reading Mode twin.
       It clears the paper, not the gutter: at 1720px the pair overruns this
       grid's content box by 16px a side, which its own --sheets-pad absorbs. */
    @media screen and (width >= 107.5rem) {
      .sheets {
        grid-template-columns: repeat(2, max-content);
      }
    }

    /* Reading Mode: one column of Blocks on a white surface, at a comfortable
       measure. The Sheets' own boxes are dismantled in Sheet.astro, so the
       items in this grid are the Blocks themselves.

       The surface is the paper's own colour, so Reading Mode takes the theme
       from the Sheets it dismantled rather than inventing one (ADR-0015). */
    @media screen and (width < 53.5rem) {
      .sheets {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        max-width: var(--reading-column-max);
        min-width: var(--reading-column-min);
        margin-inline: auto;
        /* Outside the spacing scale on purpose: this is the gap between the paper
           and the Chrome below it, not one between units of CV content (ADR-0011). */
        margin-block-end: var(--space-xl);
        padding: var(--space-xl) var(--space-l);
        background-color: var(--color-main-bg);
      }
    }
  }

  @layer print {
    /* The screen gutter must not reach paper: with it, the first Sheet is
       pushed off its A4 page and every Sheet spills onto a second one. The
       Sheets themselves are untouched, so print output equals the screen
       rendering (ADR-0001). */
    @media print {
      .sheets {
        display: block;
        gap: 0;
        padding: 0;
      }

      .sheets > * + * {
        break-before: page;
      }
    }
  }
</style>
