---
/**
 * The line(s) under a Group's title — employer / institution on the left,
 * the period right-aligned and muted, both in the display face. Only a Group
 * that opens carries this; a Continuation never repeats it.
 */
interface Props {
  lines: string[];
  period: string;
}

const { lines, period } = Astro.props;
---

<div class="group-meta">
  <div class="lines">{lines.map((line) => <p>{line}</p>)}</div>
  <p class="period">{period}</p>
</div>

<style>
  @layer components {
    .group-meta {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: 1rem;
      margin-block-start: 0.3825rem;
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      font-size: var(--font-size-meta);
      line-height: 1.13;
    }

    .lines {
      color: var(--color-heading);
    }

    .period {
      flex: none;
      color: var(--color-muted);
    }
  }
</style>
