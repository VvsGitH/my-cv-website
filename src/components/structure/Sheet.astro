---
import type { Column, CvContent, SheetNumber } from '../../content/types';
import Block from './Block.astro';

/** One Sheet (CONTEXT.md), filled by Explicit Paging (ADR-0002) in content order. */
interface Props {
  content: CvContent;
  sheet: SheetNumber;
}

const { content, sheet } = Astro.props;
const blocksIn = (column: Column) =>
  content.blocks.filter((block) => block.sheet === sheet && block.column === column);

const asideBlocks = blocksIn('aside');
// An Aside with no portrait has nothing left to show in Reading Mode, and an
// empty `complementary` is noise in the landmark outline.
const carriesPortrait = asideBlocks.some((block) => block.kind === 'photo');
---

<div class="sheet-wrapper">
  <div class="sheet">
    <div class="columns">
      <aside class="aside" data-carries-portrait={carriesPortrait ? '' : undefined}>
        {asideBlocks.map((block) => <Block block={block} />)}
      </aside>
      <div class="main">{blocksIn('main').map((block) => <Block block={block} />)}</div>
    </div>
  </div>
</div>

<style>
  /* Wrapped, or an unlayered scoped style would outrank `print` (coding-standards). */
  @layer components {
    .sheet-wrapper {
      /* Reserves the scaled footprint, which `transform: scale()` does not. */
      aspect-ratio: var(--sheet-ar);
      width: calc(var(--sheet-width) * var(--sheet-scale));
      height: auto;
      /* `min-height` zeroes the content-based automatic minimum, which would
         otherwise let the unscaled .sheet outvote `aspect-ratio`; `overflow`
         keeps that same unscaled height out of print fragmentation, where it
         costs a third page. */
      min-height: 0;
      overflow: clip;
    }

    .sheet {
      aspect-ratio: var(--sheet-ar);
      width: var(--sheet-width);
      height: auto;
      background: var(--color-main-bg);
      transform: scale(var(--sheet-scale));
      transform-origin: top left;
    }

    .columns {
      display: grid;
      grid-template-areas: 'aside main';
      grid-template-columns: var(--aside-width) 1fr;
      column-gap: var(--column-gap);
      height: 100%;
      padding-inline: var(--sheet-pad-inline-start) var(--sheet-pad-inline-end);
    }

    .aside {
      grid-area: aside;
      display: flex;
      flex-direction: column;
      /* Fixed, never `fit-content` — the panel is Sheet geometry (ADR-0011). */
      height: var(--aside-height);
      break-inside: avoid;
      /* The same inset as Main's, which is what --main-first-heading-gap no
         longer has to reconcile; see tokens.css. */
      padding-block-start: var(--sheet-pad-block-start);
      padding-inline: var(--aside-pad-inline-start) var(--aside-pad-inline-end);
      background-color: var(--color-aside-bg);
    }

    .main {
      grid-area: main;
      padding-block-start: var(--sheet-pad-block-start);
    }

    /* One value for both columns, replacing the reference's two (ADR-0011). */
    .aside :global(.block > .section-heading),
    .main :global(.block > .section-heading) {
      margin-block-start: var(--space-xl);
    }

    /* The column prefix is load-bearing specificity (hacks/2026-08-01 §9). */
    .aside :global(.block:first-child > .section-heading),
    .main :global(.block:first-child > .section-heading) {
      margin-block-start: 0;
    }

    /* Aligned to the Aside's, not spaced from the header — derived in tokens.css. */
    .main :global(.block--header + .block > .section-heading) {
      margin-block-start: var(--main-first-heading-gap);
    }

    /* Aside only: the rules reach the panel edge, the text column does not. */
    .aside :global(.block > .section-heading) {
      margin-inline-end: calc(-1 * var(--aside-pad-inline-end));
    }

    /* Reading Mode: A4 is abandoned, so every box between the reading column and
       the Blocks steps out of the flow and the Blocks of both Sheets become items
       of Document.astro's single grid (ADR-0004). */
    @media screen and (width < 53.5rem) {
      .sheet-wrapper,
      .sheet,
      .columns,
      .aside {
        display: contents;
      }

      /* Read in the Drawer down here (ADR-0008); the portrait is the exception. */
      .aside > :global(.block:not(.block--photo)) {
        display: none;
      }

      .aside > :global(.block--photo) {
        justify-self: center;
        margin-block-end: var(--space-xl);
      }

      .main {
        /* Left standing, it would place Main in an implicit column of the
           reading grid and drag the column off-centre. */
        grid-area: auto;
        padding-block-start: 0;
      }

      /* One long page down here, so the gap holds across the Sheet boundary too. */
      .main :global(.block:first-child > .section-heading) {
        margin-block-start: var(--space-xl);
      }

      /* With no Aside beside it the derived gap means nothing, and goes negative. */
      .main :global(.block--header + .block > .section-heading) {
        margin-block-start: var(--space-xl);
      }
    }
  }

  @layer print {
    /* `zoom`, not `transform: scale()`: Chrome rasterizes a transformed subtree
       into an XObject when printing, and the PDF loses every /Font — `zoom`
       scales at layout time, so the paper stays selectable text. */
    @media print {
      .sheet-wrapper {
        zoom: calc(210mm / var(--sheet-width));
      }
    }
  }
</style>
