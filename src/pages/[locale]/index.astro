---
import type { GetStaticPaths } from 'astro';
import Colophon from '../../components/chrome/Colophon.astro';
import Toolbar from '../../components/chrome/Toolbar.astro';
import Document from '../../components/structure/Document.astro';
import { cv } from '../../content';
import { chromeLinks, localePaths } from '../../i18n/locale';
import { ui } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;
const { locale } = Astro.props;
---

<BaseLayout locale={locale}>
  <Toolbar slot="masthead" toolbar={ui[locale].toolbar} links={chromeLinks(locale)} />
  <Document content={cv[locale]} />
  <Colophon slot="colophon" content={cv[locale]} />
</BaseLayout>
