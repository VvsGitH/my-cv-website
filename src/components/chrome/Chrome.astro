---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CvContent } from '../../content/types';
import { otherLocale } from '../../i18n/locale';
import { ui } from '../../i18n/ui';
import Block from '../structure/Block.astro';
import Colophon from './Colophon.astro';
import Drawer from './Drawer';
import Toolbar from './Toolbar';

/** The Chrome (CONTEXT.md): two islands and the Colophon. ADR-0007, ADR-0008, ADR-0013. */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const strings = ui[content.locale];
const asideBlocks = content.blocks.filter(
  (block) => block.column === 'aside' && block.kind !== 'photo',
);

// Written down twice, deliberately (ADR-0009). Change one end, change the other.
const pdfHref = `${import.meta.env.BASE_URL}Vito_Paparella_Santorsola_CV_${content.locale.toUpperCase()}.pdf`;
---

<Toolbar
  client:idle
  toolbar={strings.toolbar}
  drawer={strings.drawer}
  links={{
    languageHref: getRelativeLocaleUrl(otherLocale(content.locale)),
    languageLocale: otherLocale(content.locale),
    pdfHref,
  }}
/>

<Drawer client:idle name={strings.drawer.name} close={strings.drawer.close}>
  {asideBlocks.map((block) => <Block block={block} />)}
</Drawer>

<Colophon content={content} />
