---
import type { CertificationsBlock } from '../../content/types';
import SectionHeading from '../primitives/SectionHeading.astro';

interface Props {
  block: CertificationsBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} />
<ul class="certifications">
  {block.entries.map(entry => (
      <li>
        <p class="issued">
          {entry.date} | {entry.issuer}
        </p>
        {entry.url ? (
          <a class="title" href={entry.url} target="_blank" rel="noopener">
            {entry.title}
            <span class="icon icon-link" aria-hidden="true" />
          </a>
        ) : (
          <p class="title">{entry.title}</p>
        )}
      </li>
    ))}
</ul>

<style>
  @layer components {
    .certifications {
      margin-block-start: var(--space-m);
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      line-height: 1.25;
    }

    li + li {
      margin-block-start: var(--space-m);
    }

    .issued {
      color: var(--color-text);
    }

    .title {
      color: var(--color-heading);
    }

    .icon {
      display: inline-block;
      vertical-align: -0.1em;
      margin-inline-start: 0.25em;
    }
  }
</style>
