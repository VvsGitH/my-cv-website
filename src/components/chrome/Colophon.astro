---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { CvContent } from '../../content/types';
import { otherLocale } from '../../i18n/locale';
import { ui } from '../../i18n/ui';

/**
 * The Colophon (CONTEXT.md) — ADR-0013. The name and both channels are derived
 * from the header Block rather than restated, at the cost recorded there.
 */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
const other = otherLocale(content.locale);
const strings = ui[content.locale].colophon;

const header = content.blocks.find((block) => block.kind === 'header');
if (!header) {
  throw new Error(`[colophon] the ${content.locale} content has no header Block to sign off.`);
}

// Località has no `url` because it is not an action, and drops out here.
const channels = header.contacts.filter((contact) => contact.url);

// From the build, not the page load — a copyright notice dates publication (ADR-0013).
const year = new Date().getFullYear();
---

<footer class="colophon" aria-label={strings.name}>
  <p class="imprint">© {year} {header.name}</p>

  <ul class="channels">
    <li>
      <a href={getRelativeLocaleUrl(other)} lang={other} hreflang={other}>
        {ui[other].colophon.localeName}
      </a>
    </li>
    {
      channels.map((contact) => (
        <li>
          <a href={contact.url}>{contact.label}</a>
        </li>
      ))
    }
  </ul>

  <p>{strings.dataNotice}</p>


  <p>{strings.accessibility}</p>
</footer>

<style>
  @layer components {
    .colophon {
      /* On the page background, so its ink is the other theme's surface. */
      --colophon-ink: var(--color-ink);
      --colophon-ink-dark: var(--color-main-bg);

      max-width: 200ch;
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 0 var(--space-m);

      margin-inline: auto;
      padding: var(--space-l) var(--space-l) var(--space-xl) var(--space-l);
      font-size: var(--font-size-meta);
      text-align: center;
      line-height: 1.6;
      /* The same three steps reset.css takes for the background this has to
         stay legible against: a plain value for a browser without
         light-dark(), the pair for a visitor without JS, and the `data-theme`
         overrides for the Toolbar's explicit choice. */
      color: var(--colophon-ink);
      color: light-dark(var(--colophon-ink), var(--colophon-ink-dark));
    }

    @media (prefers-color-scheme: dark) {
      .colophon {
        color: var(--colophon-ink-dark);
      }
    }

    :global(html[data-theme='light']) .colophon {
      color: var(--colophon-ink);
    }

    :global(html[data-theme='dark']) .colophon {
      color: var(--colophon-ink-dark);
    }

    .colophon > * {
      width: max-content;
    }

    /* With one size and one ink to spend, tracking is the whole hierarchy (ADR-0013). */
    .imprint {
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .channels {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-s);
    }

    .channels a {
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    @media screen and (width < 51rem) {
      .colophon {
        /* The reading column's own measure: the Colophon runs in the column
           rather than under it. */
        min-width: var(--reading-column-min);
        max-width: var(--reading-column-max);
        /* Reserves the rectangle the Toolbar floats in, rather than indenting out
           of the column to dodge it (ADR-0013). Reading Mode only: Paper Mode's
           rail stands beside the Sheets, clear of normal flow. */
        padding-block-end: calc(
          var(--toolbar-block-size) + var(--toolbar-inset) + var(--space-xl)
        );
      }
    }
  }

  @layer print {
    /* Chrome is never captured (CONTEXT.md). */
    @media print {
      .colophon {
        display: none;
      }
    }
  }
</style>
