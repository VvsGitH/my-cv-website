---
import type { Column, CvContent, SheetNumber } from '../../content/types';
import Block from './Block.astro';

/** One Sheet (CONTEXT.md), filled by Explicit Paging (ADR-0002) in content order. */
interface Props {
  content: CvContent;
  sheet: SheetNumber;
}

const { content, sheet } = Astro.props;
const blocksIn = (column: Column) =>
  content.blocks.filter(
    block => block.paperSheet === sheet && block.paperColumn === column
  );

const asideBlocks = blocksIn('aside');
---

<div class="sheet">
  <div class="columns">
    <aside class="aside">
      {asideBlocks.map(block => <Block block={block} />)}
    </aside>
    <div class="main">{blocksIn('main').map(block => <Block block={block} />)}</div>
  </div>
</div>

<style>
  /* Wrapped, or an unlayered scoped style would outrank `print` (coding-standards). */
  @layer components {
    .sheet {
      aspect-ratio: var(--sheet-ar);
      width: var(--sheet-width);
      height: auto;
      flex: none; /* consistent size in flex container */
      background: var(--color-main-bg);
      transform-origin: top left;
    }

    .columns {
      display: grid;
      grid-template-areas: 'aside main';
      grid-template-columns: var(--aside-width) 1fr;
      column-gap: var(--column-gap);
      height: 100%;
      padding-inline: var(--sheet-pad-inline-start) var(--sheet-pad-inline-end);
    }

    .aside {
      /* The cream panel is the same surface in both themes, so its ink is the
         same too — not left to the theme, which would print white text on cream
         (ADR-0015). Named through `--color-aside-*` rather than off the light
         ramp directly, because the pin has to lift in Reading Mode where there
         is no panel; `tokens.css` is where the two cases are stated. Custom
         properties inherit down the DOM, so both survive the `display: contents`
         below. */
      --color-heading: var(--color-aside-heading);
      --color-text: var(--color-aside-text);
      --color-muted: var(--color-aside-muted);

      grid-area: aside;
      display: flex;
      flex-direction: column;
      /* Fixed, never `fit-content` — the panel is Sheet geometry (ADR-0011). */
      height: var(--aside-height);
      break-inside: avoid;
      /* The same inset as Main's, so the two columns start level (ADR-0011). */
      padding-block-start: var(--sheet-pad-block-start);
      padding-inline: var(--aside-pad-inline-start) var(--aside-pad-inline-end);
      background-color: var(--color-aside-bg);
    }

    .main {
      grid-area: main;
      padding-block-start: var(--sheet-pad-block-start);
    }

    /* One value for both columns, replacing the reference's two (ADR-0011). */
    .aside :global(.block > .section-heading),
    .main :global(.block > .section-heading) {
      margin-block-start: var(--space-xl);
    }

    /* The column prefix is load-bearing specificity (hacks/2026-08-01 §9). */
    .aside :global(.block:first-child > .section-heading),
    .main :global(.block:first-child > .section-heading) {
      margin-block-start: 0;
    }

    /* Main's opening Block answers to the Aside's portrait, so the two columns'
       first section headings land on one line through --space-xl like every other. */
    .main :global(.block--header) {
      min-block-size: var(--photo-size);
    }

    /* Aside only: the rules reach the panel edge, the text column does not. */
    .aside :global(.block > .section-heading) {
      margin-inline-end: calc(-1 * var(--aside-pad-inline-end));
    }

    /* Reading Mode (ADR-0017): A4 is abandoned, so every box between the reading
       column and the Blocks steps out of the flow, and the Blocks of both Sheets
       and both columns become items of Document.astro's single grid (ADR-0004).
       Nothing is hidden and nothing is rendered twice — the Aside reads here now,
       and `--read-order` is what sequences it against Main. */
    :global(html[data-mode='reading']) {
      .sheet,
      .columns,
      .aside,
      .main {
        display: contents;
      }

      /* Content order is the paper's; `order` is the reading column's (ADR-0017).
         The Blocks are items of `.sheets` by the time this reaches them. */
      .aside > :global(.block),
      .main > :global(.block) {
        order: var(--read-order);
        /* The gap above each Block, rather than above each heading. Spacing cannot
           be keyed off `:first-child` under `order` — the DOM-first Block is not
           the visually-first one — so every Block carries its own, and `.sheets`
           drops its block padding to match. The head of the column then measures
           --space-xl whichever Block sorts there. */
        margin-block-start: var(--space-xl);
      }

      /* A Continuation resumes its parent rather than opening a section, and
         `readOrder` puts it immediately after it, so it takes the gap between
         Groups instead — MainSectionBlock's `.group:first-of-type` supplies it. */
      .aside > :global(.block[data-continues]),
      .main > :global(.block[data-continues]) {
        margin-block-start: 0;
      }

      /* The gap lives on the Block now, so the heading must not add a second one. */
      .aside :global(.block > .section-heading),
      .main :global(.block > .section-heading) {
        margin-block-start: 0;
      }

      /* The rule bled into the panel's padding; there is no panel to bleed into. */
      .aside :global(.block > .section-heading) {
        margin-inline-end: 0;
      }

      .aside > :global(.block--photo) {
        justify-self: center;
      }

      /* With no Aside beside it there is nothing to answer to. */
      .main :global(.block--header) {
        min-block-size: auto;
      }
    }
  }

  @layer print {
    /* `zoom`, not `transform: scale()`: Chrome rasterizes a transformed subtree
       into an XObject when printing, and the PDF loses every /Font — `zoom`
       scales at layout time, so the paper stays selectable text. */
    @media print {
      .sheet {
        zoom: calc(210mm / var(--sheet-width));
      }

      /* The Mode is remembered, so a reader can be in Reading Mode when they
         print. Taken back rather than assumed: a leak here would still produce
         two A4 pages and `assertTwoA4Pages()` would pass in silence (ADR-0009). */
      .sheet {
        display: block;
      }

      .columns {
        display: grid;
      }

      .aside {
        display: flex;
      }

      .main {
        display: block;
      }

      .aside > :global(.block),
      .main > :global(.block) {
        order: 0;
        margin-block-start: 0;
      }
    }
  }
</style>
