---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/locale';
import { meta } from '../i18n/meta';
import { ogCard } from '../lib/og-card';
import '../styles/global.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = meta[locale];

const canonical = getAbsoluteLocaleUrl(locale);
const alternates = Object.keys(meta) as Locale[];

// scripts/render-captures.mjs writes this beside the page after the build.
const ogImage = new URL(`${import.meta.env.BASE_URL}og-${locale}.png`, Astro.site).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- All fonts and variants but the signature are present above the first fold -->
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-atkinson" preload />
    <Font cssVariable="--font-icomoon" preload />
    <Font cssVariable="--font-primera-signature" />

    <title>{strings.title}</title>
    <meta name="description" content={strings.description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <!-- Italian is the site's default Locale for reader with unsupported languages -->
    <link rel="canonical" href={canonical} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate} href={getAbsoluteLocaleUrl(alternate)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('it')} />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={strings.title} />
    <meta property="og:description" content={strings.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={strings.ogLocale} />
    {alternates
      .filter((alternate) => alternate !== locale)
      .map((alternate) => (
        <meta property="og:locale:alternate" content={meta[alternate].ogLocale} />
      ))}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogCard.width)} />
    <meta property="og:image:height" content={String(ogCard.height)} />
    <meta property="og:image:alt" content={strings.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Setting the theme in a blocking way to avoid flashes. The default is based on the user OS -->
    <script is:inline>
      let storedTheme = null;
      try {
        storedTheme = localStorage.getItem('cv-theme');
      } catch {}
      const theme =
        storedTheme === 'light' || storedTheme === 'dark'
          ? storedTheme
          : matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
      document.documentElement.dataset.theme = theme;
      document.documentElement.style.colorScheme = theme;
    </script>

    <!-- Setting the mode in a blocking way to avoid flashes. The default is paper (ADR-0017). -->
    <script is:inline>
      let storedMode = null;
      try {
        storedMode = localStorage.getItem('cv-mode');
      } catch {}
      document.documentElement.dataset.mode = storedMode === 'reading' ? 'reading' : 'paper';
    </script>

    <!-- Define css layers: this must precede the imports or the minifier reorders it -->
    <style is:inline>
      @layer reset, base, components, print;
    </style>
  </head>

  <body>
    <main>
      <slot />
    </main>
    <!-- Chrome sits outside <main>: it is not the paper (CONTEXT.md). -->
    <slot name="chrome" />
  </body>
</html>
