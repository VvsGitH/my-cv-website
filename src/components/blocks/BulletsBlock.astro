---
import type { BulletsBlock } from '../../content/types';
import Bullets from '../primitives/Bullets.astro';
import SectionHeading from '../primitives/SectionHeading.astro';

interface Props {
  block: BulletsBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} />
<div class="plain-list">
  <Bullets items={block.items} />
</div>

<style>
  @layer components {
    .plain-list {
      --bullet-gap: var(--space-m);

      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
    }
  }
</style>
