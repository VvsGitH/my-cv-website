---
import Rich from './Rich.astro';

/**
 * A bulleted list. The owning Block tunes it through `--bullet-gap` and
 * `--bullet-leading`, and by setting a font on the wrapper — the reference
 * sets its Aside lists looser and in the display face, but the marker,
 * indent and hanging alignment are the same everywhere.
 */
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="bullets">
  {
    items.map((item) => (
      <li>
        <Rich text={item} />
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .bullets {
      margin-block-start: var(--bullet-gap, 0.125rem);
      padding-inline-start: 0.22rem;
      /* Experience sets its bullets looser than Projects does in the
         reference; the owning Block picks via --bullet-leading. */
      line-height: var(--bullet-leading, 1.417);
      color: var(--color-text);
    }

    li {
      padding-inline-start: 0.85rem;
      text-indent: -0.85rem;
    }

    li::before {
      content: '•';
      padding-inline-end: 0.45rem;
    }
  }
</style>
