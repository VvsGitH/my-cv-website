---
import type { PrivacyBlock } from '../../content/types';
import Rich from '../primitives/Rich.astro';
import SectionHeading from '../primitives/SectionHeading.astro';

interface Props {
  block: PrivacyBlock;
}

const { block } = Astro.props;

// From the build, not the page load — as with the Colophon's © (ADR-0013).
// `DD/MM/YYYY`, zero-padded, in both Locales: the European order the place (Bari)
// implies, and the same slashes as the periods' `MM/YYYY`. One shape for both
// renderings of the statement, so they cannot drift apart.
const now = new Date();
const date = [
  String(now.getDate()).padStart(2, '0'),
  String(now.getMonth() + 1).padStart(2, '0'),
  now.getFullYear(),
].join('/');
---

<SectionHeading text={block.heading} />
<p class="statement">
  <Rich text={block.statement} />
</p>
<p class="place-date">{block.place}, {date}</p>
<p class="signature" aria-hidden="true">{block.signature}</p>

<style>
  @layer components {
    .statement {
      margin-block-start: var(--space-m);
      line-height: var(--prose-leading);
      text-align: var(--prose-align);
      color: var(--color-text);
    }

    .place-date {
      margin-block-start: var(--space-m);
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      text-align: end;
      color: var(--color-text);
    }

    /* A script-face approximation, never a scan of the real signature (ADR-0024). */
    .signature {
      margin-block-start: var(--space-s);
      font-family: var(--font-signature);
      font-weight: var(--font-weight-signature);
      font-size: var(--font-size-name);
      text-align: right;
      line-height: 1.6;
      color: var(--color-signature);
    }
  }
</style>
