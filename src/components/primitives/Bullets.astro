---
import Rich from './Rich.astro';

/**
 * A bulleted list. The owning Block tunes the gap above it through
 * `--bullet-gap`and sets its own font on the wrapper; the marker, 
 * indent, hanging alignment and leading are the same everywhere.
 */
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<ul class="bullets">
  {
    items.map((item) => (
      <li>
        <Rich text={item} />
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .bullets {
      margin-block-start: var(--bullet-gap, var(--space-s));
      padding-inline-start: 0.22rem;
      line-height: var(--prose-leading);
      color: var(--color-text);
    }

    li {
      padding-inline-start: 0.85rem;
      text-indent: -0.85rem;
    }

    li::before {
      content: '•';
      padding-inline-end: 0.45rem;
    }
  }
</style>
