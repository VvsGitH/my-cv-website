---
import type { SkillsBlock } from '../../content/types';
import SectionHeading from '../primitives/SectionHeading.astro';
import Rich from '../primitives/Rich.astro';

interface Props {
  block: SkillsBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} />
{
  block.groups.map((group) => (
    <section class="group">
      <h3 class="group-name">{group.name}</h3>
      {group.display === 'inline' ? (
        <p class="run">
          {group.items.map((item, i) => (
            <>
              {i > 0 && <span class="sep"> / </span>}
              <Rich text={item} />
            </>
          ))}
        </p>
      ) : (
        <ul class="list">
          {group.items.map((item) => (
            <li>
              <Rich text={item} />
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}

<style>
  @layer components {
    /* Both the gap under the section heading and the gap between two Skills
       groups — the scale gives them the same value, so one rule covers both. */
    .group {
      margin-block-start: var(--space-m);
    }

    .group-name {
      font-family: var(--font-heading);
      font-weight: var(--font-weight-subheading);
      font-size: var(--font-size-subheading);
      line-height: 1.22;
      color: var(--color-heading);
    }

    .run,
    .list {
      margin-block-start: var(--space-s);
      color: var(--color-text);
      line-height: var(--prose-leading);
    }

    li {
      padding-inline-start: var(--bullet-list-pad-start);
      text-indent: calc(var(--bullet-list-pad-start) * -1);
    }

    li::before {
      content: '•';
      padding-inline-end: calc(var(--bullet-list-pad-start) - 0.35rem);
    }
  }
</style>
