---
import type { LanguagesBlock } from '../../content/types';
import SectionHeading from '../primitives/SectionHeading.astro';

interface Props {
  block: LanguagesBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} />
<dl class="languages">
  {block.entries.map((entry) => (
      <div
        class="language"
        style={`--fill: ${(entry.proficiency * 100).toFixed(1)}%`}
      >
        <dt>{entry.name}</dt>
        <dd>{entry.level}</dd>
      </div>
    ))}
</dl>

<style>
  @layer components {
    .languages {
      margin-block-start: var(--space-m);
      color: var(--color-heading);
    }

    .language {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: baseline;
      line-height: 1.15;
    }

    .language + .language {
      margin-block-start: var(--space-m);
    }

    dd {
      margin-inline-start: 0;
      font-style: italic;
      color: var(--color-text);
    }

    /* The bar restates the `dd` beside it — `proficiency` was read off the
       reference bars, not measured apart from the CEFR label (ADR-0014) — so it
       is drawn as generated content: nothing in the DOM to break the `dl`
       content model, and nothing in the accessibility tree to announce a
       percentage over the level text. */
    .language::after {
      content: '';
      grid-column: 1 / -1;
      height: var(--skill-bar-height);
      margin-block-start: var(--space-xs);
      background-image: linear-gradient(
        to right,
        var(--color-text) var(--fill),
        color-mix(in oklab, var(--color-text) 20%, transparent) var(--fill)
      );
    }
  }
</style>
