---
import type { Column, CvContent, SheetNumber } from '../../content/types';
import Block from './Block.astro';

/**
 * One Sheet of the CV (CONTEXT.md: "Sheet") — a real 210mm × 297mm box
 * holding the cream Aside panel and the white Main column, each filled with
 * the Blocks that name it (Explicit Paging, ADR-0002). Blocks render in
 * content order.
 *
 * The A4 box is always physically real: responsive scaling is purely visual
 * via `--sheet-scale`, so print/PDF capture — which reads the untransformed
 * layout box via `@page` in global.css — is never affected by whatever scale
 * the screen happens to be showing.
 */
interface Props {
  content: CvContent;
  sheet: SheetNumber;
}

const { content, sheet } = Astro.props;
const blocksIn = (column: Column) =>
  content.blocks.filter((block) => block.sheet === sheet && block.column === column);
---

<div class="sheet-wrapper">
  <div class="sheet">
    <div class="columns">
      <aside class="aside">
        {blocksIn('aside').map((block) => <Block block={block} />)}
      </aside>
      <div class="main">{blocksIn('main').map((block) => <Block block={block} />)}</div>
    </div>
  </div>
</div>

<style>
  /* `components` layer (see global.css) — kept in the cascade-layer system so
     a later `print`-layer rule can still override this without a specificity
     fight; unlayered styles would always win otherwise. */
  @layer components {
    .sheet-wrapper {
      /* Reserves the visually scaled footprint in normal layout flow, since
         `transform: scale()` on .sheet doesn't affect its layout box. */
      width: calc(210mm * var(--sheet-scale, 1));
      height: calc(297mm * var(--sheet-scale, 1));
    }

    .sheet {
      width: 210mm;
      height: 297mm;
      background: var(--color-main-bg);
      transform: scale(var(--sheet-scale, 1));
      transform-origin: top left;
    }

    .columns {
      display: grid;
      grid-template-areas: 'aside main';
      grid-template-columns: var(--aside-width) var(--main-width);
      column-gap: var(--column-gap);
      height: 100%;
      padding-inline: var(--aside-inset-inline) var(--sheet-pad-inline-end);
    }

    .aside {
      grid-area: aside;
      display: flex;
      flex-direction: column;
      /* The panel stops short of the page bottom, and its heading rules run
         past the text column to the panel's own edge.

         A fixed height, not `fit-content`: the panel is Sheet geometry and
         must be identical on both Sheets. Sheet 2's content ends well above
         it — the empty cream below the signature is intended, and a panel
         that shrank to fit would read as a rendering bug in the PDF. */
      height: var(--aside-height);
      break-inside: avoid;
      /* One of the four inputs to --main-first-heading-gap; see tokens.css. */
      padding-block-start: var(--aside-pad-block-start);
      padding-inline: var(--aside-pad-inline-start) var(--aside-pad-inline-end);
      background-color: var(--color-aside-bg);
    }

    .main {
      grid-area: main;
      padding-block-start: var(--main-inset-block-start);
    }

    /* Gap above a new section — one value for both columns. The reference
       hand-places these (40px in the Aside, 85.6px in Main); ticket 17
       replaced both with the scale's top step. */
    .aside :global(.block > .section-heading),
    .main :global(.block > .section-heading) {
      margin-block-start: var(--space-xl);
    }

    /* Needs the column prefix: the rule above is scoped (Astro adds an
       attribute to `.aside`/`.main`), so an unprefixed override would lose on
       specificity and the first section would gain a gap. */
    .aside :global(.block:first-child > .section-heading),
    .main :global(.block:first-child > .section-heading) {
      margin-block-start: 0;
    }

    /* Main's first heading is aligned to the Aside's rather than spaced from
       the header — the one gap off the scale, derived in tokens.css. */
    .main :global(.block--header + .block > .section-heading) {
      margin-block-start: var(--main-first-heading-gap);
    }

    /* Aside only: the rules reach the panel edge, though the text column
       stops short of it. */
    .aside :global(.block > .section-heading) {
      margin-inline-end: calc(-1 * var(--aside-pad-inline-end));
    }
  }
</style>
