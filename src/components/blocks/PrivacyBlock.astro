---
import type { PrivacyBlock } from '../../content/types';
import SectionHeading from '../primitives/SectionHeading.astro';
import Rich from '../primitives/Rich.astro';

interface Props {
  block: PrivacyBlock;
}

const { block } = Astro.props;
---

<SectionHeading text={block.heading} />
<p class="statement">
  <Rich text={block.statement} />
</p>
<p class="place-date">{block.place}, {block.date}</p>
<p class="signature" aria-hidden="true">{block.signature}</p>

<style>
  @layer components {
    .statement {
      margin-block-start: var(--space-m);
      line-height: var(--prose-leading);
      text-align: var(--prose-align);
      color: var(--color-text);
    }

    .place-date {
      margin-block-start: var(--space-m);
      font-family: var(--font-display);
      font-weight: var(--font-weight-display);
      text-align: end;
      color: var(--color-text);
    }

    /* A script-face approximation, never a scan of the real signature (ADR-0012). */
    .signature {
      margin-block-start: var(--space-s);
      font-family: var(--font-signature);
      font-weight: var(--font-weight-signature);
      font-size: var(--font-size-name);
      text-align: right;
      line-height: 1.6;
      color: var(--color-signature);
    }
  }
</style>
