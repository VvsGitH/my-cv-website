---
/** A Group's title line (CONTEXT.md). `srOnly` marks a Continuation (ADR-0005). */
interface Props {
  text: string;
  srOnly?: boolean;
}

const { text, srOnly } = Astro.props;
---

<h3 class:list={['group-title', { 'is-sr-only': srOnly }]}>{text}</h3>

<style>
  @layer components {
    .group-title {
      font-family: var(--font-heading);
      font-weight: var(--font-weight-heading);
      font-size: var(--font-size-subheading);
      line-height: 1.5;
      color: var(--color-heading);
    }
  }
</style>
