---
import type { CvContent } from '../../content/types';
import Sheet from './Sheet.astro';

/** The whole CV: its two Sheets, laid out as paper. */
interface Props {
  content: CvContent;
}

const { content } = Astro.props;
---

<div class="sheets">
  <Sheet content={content} sheet={1} />
  <Sheet content={content} sheet={2} />
</div>

<style>
  @layer components {
    .sheets {
      /* Screen gutters, not reference geometry — and also the arithmetic
         behind --sheet-fit-width below, which is why they are named rather
         than repeated. Zeroed for print in the layer below. */
      --sheets-gap: 1.5rem;
      --sheets-pad: 1.5rem;

      gap: var(--sheets-gap);
      padding: var(--sheets-pad);
    }

    /* Arranging the Sheets is a screen concern: on paper each one is a block
       that takes its own page, and this container has no say in it. Every
       alignment declaration stays inside `screen` for a measured reason —
       ticket 06, "Print parity was measured".

       Grid rather than a wrapping flex line: the wide tier scales the pair to
       span the viewport exactly, and a flex line that rounded up by a fraction
       of a pixel would drop one Sheet onto a row of its own. A grid's track
       count cannot move under it. */
    @media screen {
      .sheets {
        display: grid;
        grid-template-columns: max-content;
        justify-content: center;
      }
    }

    /* Wide: two Sheets side by side, sharing the row with the gap between
       them — the grid of pages.

       102rem (1632px) rather than ticket 06's 80rem: ADR-0006 removed the
       dynamic --sheet-fit-width scaling in favour of a literal A4 box, so this
       tier has to clear two 793.7px Sheets and the 1.5rem gap between them
       — 1611.4px — or the pair overflows the viewport. The boundary is stated
       once here and reasoned about in tokens.css beside its Reading Mode twin. */
    @media screen and (width >= 102rem) {
      .sheets {
        grid-template-columns: repeat(2, max-content);
      }
    }

    /* Reading Mode: one column of Blocks on a white surface, at a comfortable
       measure. The Sheets' own boxes are dismantled in Sheet.astro, so the
       items in this grid are the Blocks themselves.

       The surface stays white in both themes for the same reason the paper
       does (spec US17): the CV is a document, and --color-text is set to be
       read off white. */
    @media screen and (width < 51rem) {
      .sheets {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        max-width: var(--reading-column-max);
        min-width: var(--reading-column-min);
        margin-inline: auto;
        padding: var(--space-xl) var(--space-l);
        background-color: var(--color-main-bg);
      }
    }
  }

  @layer print {
    /* The screen gutter must not reach paper: with it, the first Sheet is
       pushed off its A4 page and every Sheet spills onto a second one. The
       Sheets themselves are untouched, so print output equals the screen
       rendering (ADR-0001). */
    @media print {
      .sheets {
        display: block;
        gap: 0;
        padding: 0;
      }

      .sheets > * + * {
        break-before: page;
      }
    }
  }
</style>
