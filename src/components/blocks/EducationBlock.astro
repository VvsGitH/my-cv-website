---
import type { EducationBlock } from '../../content/types';
import SectionHeading from '../primitives/SectionHeading.astro';
import EntryTitle from '../primitives/EntryTitle.astro';
import EntryMeta from '../primitives/EntryMeta.astro';
import Rich from '../primitives/Rich.astro';

interface Props {
  block: EducationBlock;
}

const { block } = Astro.props;
---

{block.heading && <SectionHeading text={block.heading} />}
<EntryTitle text={block.qualification} />
<EntryMeta lines={[block.institution]} period={block.period} />
<div class="details">
  {
    block.details.map((detail) => (
      <p>
        <Rich text={detail} />
      </p>
    ))
  }
</div>

<style>
  @layer components {
    .details {
      margin-block-start: 0.5rem;
      line-height: 1.417;
      color: var(--color-text);
    }
  }
</style>
