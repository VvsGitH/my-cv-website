---
import type { SkillsBlock } from '../../../content/types';
import SectionHeading from '../SectionHeading.astro';
import Rich from '../Rich.astro';

interface Props {
  block: SkillsBlock;
}

const { block } = Astro.props;
---

{block.heading && <SectionHeading text={block.heading} />}
{
  block.groups.map((group) => (
    <section class="group">
      <h3 class="group-name">{group.name}</h3>
      {group.display === 'inline' ? (
        <p class="run">
          {group.items.map((item, i) => (
            <>
              {i > 0 && <span class="sep"> / </span>}
              <Rich text={item} />
            </>
          ))}
        </p>
      ) : (
        <ul class="list">
          {group.items.map((item) => (
            <li>
              <Rich text={item} />
            </li>
          ))}
        </ul>
      )}
    </section>
  ))
}

<style>
  @layer components {
    .group {
      margin-block-start: 0.875rem;
    }

    .group-name {
      font-family: var(--font-heading);
      font-weight: var(--font-weight-heading);
      font-size: var(--font-size-subheading);
      line-height: 1.22;
      color: var(--color-heading);
    }

    .run,
    .list {
      margin-block-start: 0.28rem;
      /* Tech Skills items are set a step smaller than the rest of the
         Aside prose in the reference. */
      font-size: var(--font-size-skill);
      color: var(--color-text);
    }

    .run {
      line-height: 2;
      /* Generous leading matches the reference’s 18.96px pitch, but it
         also pads the block; trim the trailing half-leading so the next
         group starts where the reference puts it. */
      margin-block-end: -0.3rem;
    }

    .list {
      padding-inline-start: 0.2rem;
      line-height: 1.417;
    }

    li {
      padding-inline-start: 0.62rem;
      text-indent: -0.62rem;
    }

    li::before {
      content: '•';
      padding-inline-end: 0.34rem;
    }
  }
</style>
